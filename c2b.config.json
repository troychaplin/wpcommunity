{
    "prefix": "wpc",

    "output": {
        "srcDir": "src/styles",
        "outputDir": ".c2b",
        "themeable": false,
        "emitScssAlongside": false,
        "emitAggregate": false,
        "scssVars": ["viewport", "spacing", "radius"]
    },

    "fluid": {
        "minViewport": "320px",
        "maxViewport": "1280px"
    },

    "tokens": {
        "layout": {
            "contentSize": "768px",
            "wideSize": "1280px",
            "smallSize": { "value": "600px", "cssOnly": true },
            "fullSize": { "value": "100vw", "cssOnly": true },
            "avatarSmall": { "value": "2.25rem", "cssOnly": true },
            "avatarMedium": { "value": "3.5rem", "cssOnly": true },
            "avatarLarge": { "value": "4.75rem", "cssOnly": true }
        },

        "viewport": {
            "mobile": "600px",
            "tablet": "960px"
        },

        "color": {
            "crimson-100": { "value": "#f5ebea", "cssOnly": true },
            "crimson-300": { "value": "#e8a5af", "cssOnly": true },
            "crimson-600": "#b01d33",
            "crimson-700": { "value": "#8e1728", "cssOnly": true },

            "forest-100": "#e4efe8",
            "forest-400": { "value": "#8fa79a", "cssOnly": true },
            "forest-600": { "value": "#5a7165", "cssOnly": true },
            "forest-800": "#2c493d",
            "forest-900": "#1c3528",
            "forest-950": "#0f251b",

            "sage-50": "#eff4f0",
            "sage-200": { "value": "#e2e7e3", "cssOnly": true },
            "sage-600": "#64706a",
            "sage-800": { "value": "#34453c", "cssOnly": true },
            "sage-900": "#25332c",

            "stone-50": "#faf8f4",
            "stone-100": { "value": "#f1efea", "cssOnly": true },
            "stone-200": "#e8e6e1",

            "white": "#ffffff",

            "primary": { "value": "var(--wpc--color-crimson-600)", "cssOnly": true },
            "primary-hover": { "value": "var(--wpc--color-crimson-700)", "cssOnly": true },
            "accent": { "value": "var(--wpc--color-crimson-600)", "cssOnly": true },
            "heading": { "value": "var(--wpc--color-forest-950)", "cssOnly": true },
            "text": { "value": "var(--wpc--color-sage-900)", "cssOnly": true },
            "text-muted": { "value": "var(--wpc--color-sage-600)", "cssOnly": true },
            "background": { "value": "var(--wpc--color-stone-50)", "cssOnly": true },
            "surface": { "value": "var(--wpc--color-white)", "cssOnly": true },
            "surface-tint": { "value": "var(--wpc--color-sage-50)", "cssOnly": true },
            "border": { "value": "var(--wpc--color-stone-200)", "cssOnly": true },
            "border-hover": { "value": "var(--wpc--color-sage-600)", "cssOnly": true },
            "field": { "value": "var(--wpc--color-white)", "cssOnly": true },
            "field-border": { "value": "var(--wpc--color-border)", "cssOnly": true },
            "inverse": { "value": "var(--wpc--color-forest-950)", "cssOnly": true },
            "text-inverse": { "value": "var(--wpc--color-forest-100)", "cssOnly": true },
            "text-inverse-muted": { "value": "var(--wpc--color-forest-400)", "cssOnly": true },
            "accent-inverse": { "value": "var(--wpc--color-crimson-300)", "cssOnly": true }
        },

        "gradient": {
            "blush": {
                "value": "linear-gradient(160deg,rgb(246,236,230) 0%,rgb(250,248,244) 65%)",
                "slug": "custom-blush"
            },
            "forest-glow": {
                "value": "radial-gradient(circle at 92% 18%,rgb(176 29 51 / 0.22) 0%,transparent 45%)",
                "slug": "custom-forest-glow"
            }
        },

        "fontFamily": {
            "serif": "var(--font-cormorant), 'Cormorant Garamond', Georgia, serif",
            "sans": "var(--font-jakarta), 'Plus Jakarta Sans', system-ui, sans-serif",
            "mono": "var(--font-plex-mono), 'IBM Plex Mono', ui-monospace, monospace"
        },

        "fontWeight": {
            "light": "300",
            "normal": "400",
            "medium": "500",
            "semibold": "600",
            "bold": "700"
        },

        "fontSize": {
            "x-small": { "value": "0.875rem", "fluid": { "min": "0.8125rem", "max": "0.875rem" }, "cssOnly": true },
            "small": { "min": "0.8125rem", "max": "0.875rem" },
            "medium": { "min": "0.9375rem", "max": "1rem" },
            "large": { "min": "1rem", "max": "1.125rem" },
            "x-large": { "min": "1.125rem", "max": "1.25rem" },
            "2x-large": { "min": "1.25rem", "max": "1.5rem" },
            "heading-small": { "min": "1.375rem", "max": "1.75rem" },
            "heading-medium": { "min": "1.75rem", "max": "2.5rem" },
            "heading-large": { "min": "2.125rem", "max": "3rem" },
            "display": { "value": "5.625rem", "fluid": { "min": "2.75rem", "max": "5.625rem" }, "cssOnly": true }
        },

        "spacing": {
            "2x-small": { "value": "0.25rem", "slug": "20" },
            "x-small": { "value": "0.5rem", "slug": "30" },
            "small": { "value": "1rem", "slug": "40" },
            "medium": { "value": "clamp(1.25rem, 2.5vw, 1.75rem)", "slug": "50" },
            "large": { "value": "clamp(2rem, 4.5vw, 3.5rem)", "slug": "60" },
            "x-large": { "value": "clamp(3rem, 7vw, 5rem)", "slug": "70" },
            "2x-large": { "value": "clamp(4rem, 10vw, 7.5rem)", "slug": "80" }
        },

        "shadow": {
            "subtle": "0 1px 2px rgb(15 37 27 / 0.04), 0 1px 3px rgb(15 37 27 / 0.06)",
            "raised": "0 12px 32px -12px rgb(15 37 27 / 0.35)"
        },

        "lineHeight": {
            "flat": "1",
            "tight": "1.1",
            "snug": "1.3",
            "normal": "1.5",
            "relaxed": "1.65"
        },

        "radius": {
            "sm": "4px",
            "md": "6px",
            "lg": "8px",
            "full": "9999px"
        },

        "transition": {
            "fast": "150ms ease",
            "normal": "250ms ease"
        },

        "zIndex": {
            "100": "100",
            "200": "200",
            "500": "500"
        }
    },

    "baseStyles": {
        "body": {
            "fontFamily": "sans",
            "fontSize": "medium",
            "fontWeight": "normal",
            "lineHeight": "normal",
            "color": "text",
            "background": "background"
        },
        "heading": {
            "fontFamily": "serif",
            "fontWeight": "medium",
            "lineHeight": "tight",
            "letterSpacing": "-0.01em",
            "color": "heading"
        },
        "h1": { "fontSize": "heading-large", "marginBlockStart": "x-large" },
        "h2": { "fontSize": "heading-medium", "marginBlockStart": "large" },
        "h3": { "fontSize": "heading-small", "marginBlockStart": "large" },
        "h4": { "fontSize": "2x-large", "marginBlockStart": "medium" },
        "h5": { "fontSize": "x-large", "marginBlockStart": "medium" },
        "h6": { "fontSize": "large", "marginBlockStart": "medium" },
        "caption": { "fontSize": "small", "color": "text-muted" },
        "link": { "color": "primary", "hoverColor": "primary-hover" },
        "spacing": {
            "blockGap": "medium",
            "afterHeading": "small",
            "entryContent": "small",
            "padding": {
                "top": "0",
                "right": "medium",
                "bottom": "0",
                "left": "medium"
            }
        }
    }
}
